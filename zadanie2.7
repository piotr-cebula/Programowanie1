magazyn = {"Mysz": 5, "Klawiatura": 3, "Monitor": 2}

while True:
    print("1 - Stan magazynu")
    print("2 - Przyjecie towaru")
    print("3 - Wydanie towaru")
    print("0 - Zakoncz")
    
    opcja = int(input("Wybierz opcje: "))
    
    if opcja == 1:
        for produkt, ilosc in magazyn.items():
            print(f"{produkt}: {ilosc} szt.")
    elif opcja == 2:
        produkt = input("Nazwa produktu: ")
        ilosc = int(input("Liczba sztuk: "))
        if produkt in magazyn:
            magazyn[produkt] += ilosc
        else:
            magazyn[produkt] = ilosc
        print("Zaktualizowano stan produktu.")
    elif opcja == 3:
        produkt = input("Nazwa produktu: ")
        ilosc = int(input("Liczba sztuk: "))
        if produkt in magazyn:
            if magazyn[produkt] >= ilosc:
                magazyn[produkt] -= ilosc
                print(f"Wydano {ilosc} szt.")
            else:
                print("Niewystarczajaca liczba sztuk w magazynie.")
        else:
            print("Brak produktu w magazynie.")
    elif opcja == 0:
        print("Do widzenia!")
        break
    else:
        print("Nieprawidlowa opcja.")
