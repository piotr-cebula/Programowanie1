poczatek = int(input("Podaj poczatek zakresu: "))
koniec = int(input("Podaj koniec zakresu: "))

liczba_parzystych = 0
liczba = poczatek  # Zaczynamy sprawdzanie od liczby początkowej

while liczba <= koniec:
    if liczba % 2 == 0:
        print(f"{liczba}- Parzysta")
        liczba_parzystych = liczba_parzystych + 1
    else:
        print(f"{liczba}- Nieparzysta")
        
    liczba = liczba + 1  # Bierzemy kolejną liczbę do sprawdzenia

print(f"Liczba liczb parzystych: {liczba_parzystych}")
